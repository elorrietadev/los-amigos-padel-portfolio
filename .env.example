# Copiar a .env y completar con los valores del proyecto Supabase propio.
# La anon/publishable key es pública por diseño: la seguridad real la aplican RLS y los permisos de las funciones.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Kill-switch de emergencia para el panel de Configuración del admin.
# Ausente o "true" = visible (default). Poner en "false" solo para ocultarla.
# VITE_ADMIN_CONFIGURACION_UI=false

# Turnstile: site key PÚBLICA. La secret key se configura solo como secreto del servidor, nunca en el repo.
# Claves de TEST oficiales de Cloudflare para desarrollo (nunca validan en producción):
#   1x00000000000000000000AA  siempre pasa (visible)
#   2x00000000000000000000AB  siempre falla
#   3x00000000000000000000FF  fuerza desafío interactivo (para probar la UX)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
