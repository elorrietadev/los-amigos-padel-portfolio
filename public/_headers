# Reemplazar YOUR_PROJECT_REF por la referencia del proyecto Supabase propio.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/productos-catalogo/; connect-src 'self' https://YOUR_PROJECT_REF.supabase.co wss://YOUR_PROJECT_REF.supabase.co; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'none'

/
  Cache-Control: no-cache

/admin/
  Cache-Control: no-cache

/baja/
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
